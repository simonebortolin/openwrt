/* The F6005's OMCI panel, a node of the root: its board tree and its virtual unit include it where it sits, so both declare one panel. */
	/* The OMCI panel the OLT counts.  Based on the X100DG's stock MIB (same
	 * SoC, same single-port form factor); the F6005 is a CIG design so its
	 * own stock MIB (omci_panel.py over gpon-oracle) may differ — particularly
	 * circuit-pack IDs, the CTC ONU capability and extra-me-instances.
	 *
	 * TODO(bring-up): capture a gpon-oracle from a stock F6005 at O5 and run
	 * omci_panel.py to get the board's own OMCI panel. */
	omci-uni {
		ethernet-uni-instances = /bits/ 16 <0x0101>;
		ethernet-uni-ports = /bits/ 8 <1>;
		ethernet-uni-types = /bits/ 8 <47>;
		uni-g-instances = /bits/ 16 <0x0101 0x0601>;
		uni-g-management-capability = /bits/ 8 <1 0>;
		circuit-packs = /bits/ 16 <
			0x0101 47 1 8 0 0
			0x0106 48 1 8 0 0
			0x0180 248 1 128 16 16>;
		ip-host-instances = /bits/ 16 <0x0000 0x0001 0x0002>;
		ip-host-wan-mac = /bits/ 8 <0 0 0>;
		onu-capacity = /bits/ 16 <16 128 16 64>;
		downstream-queue-ports = /bits/ 16 <0x0101 0x0601>;
		extra-me-instances = /bits/ 16 <83 0  133 0  340 0x0601  65294 0  65363 0  65529 0>;
	};
